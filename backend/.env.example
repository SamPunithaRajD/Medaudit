# MedAudit AI 2.0 backend configuration. Copy to backend/.env and fill in secrets.
# Never commit .env. Generate secrets with:  python scripts/generate_secrets.py

APP_NAME=MedAudit AI
APP_ENV=development            # development | test | staging | production
APP_DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://medaudit:CHANGE_ME@localhost:5432/medaudit

# Local AI (Ollama). Patient data never leaves the machine/LAN.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=180
OLLAMA_ENABLED=true
LOCAL_ONLY_AI=true             # refuse non-loopback/non-private LLM endpoints
LOCAL_AI_ALLOWED_HOSTS=        # extra trusted LAN hostnames, comma-separated
EXTERNAL_LLM_ENABLED=false     # no external LLM integration exists; kept false
LLM_CLASSIFICATION_ENABLED=true

# HTTP / CORS (exact origins of the React app). ALLOWED_ORIGINS is an alias.
ALLOWED_ORIGINS=http://localhost:5173
# Public URL of the web app (used in activation / reset links shown to administrators)
APP_BASE_URL=http://localhost:5173
TRUSTED_HOSTS=                 # e.g. medaudit.hospital.local,localhost
ENFORCE_HTTPS=false            # true behind a TLS-terminating reverse proxy

# Uploads (contract recommends 100 MiB)
MAX_UPLOAD_SIZE_MB=100
MAX_PDF_PAGES=250
MAX_ZIP_MEMBERS=300
MAX_ZIP_UNCOMPRESSED_MB=1024
MAX_ZIP_COMPRESSION_RATIO=100
STORAGE_DIR=./storage

# Processing
WORKER_MODE=external           # external (run app.workers.run_worker) | embedded (dev only) | disabled
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL=2
PAGE_BATCH_SIZE=10
PAGE_MAX_RETRIES=2
JOB_MAX_ATTEMPTS=3
JOB_LOCK_TIMEOUT_SECONDS=900
OCR_PROVIDERS=pdf_text,tesseract
OCR_EXTRA_PROVIDER=            # package.module:ClassName (handwriting-capable recogniser)
TESSERACT_CMD=                 # e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANG=eng
OCR_RENDER_DPI=200
OCR_LOW_CONFIDENCE_THRESHOLD=60
HOSPITAL_TIMEZONE=Asia/Kolkata # case-sheet wall-clock times are interpreted in this zone

# Security — REQUIRED. Keys live outside the database and source code.
ENCRYPTION_KEYS=               # v1:<base64 32-byte key>[,v2:<key>]
ENCRYPTION_ACTIVE_KEY_VERSION=v1
ENCRYPTION_KEY=                # alternative single key (treated as v1)
SESSION_SECRET=                # >= 32 random characters
AUDIT_LOG_HMAC_KEY=            # separate key for the audit-log hash chain
SESSION_COOKIE_SECURE=false    # MUST be true with HTTPS (staging/production)
SESSION_COOKIE_SAMESITE=lax
SESSION_DURATION=480            # absolute session length in minutes (alias SESSION_TTL_MINUTES)
SESSION_IDLE_TIMEOUT_MINUTES=60
PASSWORD_MIN_LENGTH=12
ACTIVATION_TOKEN_EXPIRY=72     # initial activation-code validity (hours); then editable in the admin portal
LOGIN_RATE_LIMIT_PER_MINUTE=10
SENSITIVE_RATE_LIMIT_PER_MINUTE=30

# Analytics
ANALYTICS_MIN_CELL_SIZE=5      # counts below this are suppressed (null)
